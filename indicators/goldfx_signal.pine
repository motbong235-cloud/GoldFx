//@version=5
indicator("Gold Fx Signal · Et / TP / SL", overlay=true, max_lines_count=300, max_labels_count=300)

// ===== Inputs =====
swingLen = input.int(10, "Swing length", minval=2)
slBuf    = input.float(0.5, "SL buffer (price)", minval=0.0, step=0.1)
rr1      = input.float(1.0, "TP1 (R)", minval=0.1, step=0.25)
rr2      = input.float(2.0, "TP2 (R)", minval=0.1, step=0.25)
et2Pct   = input.float(0.78, "Et 2 position (0 = SL, 1 = Et 1)", minval=0.1, maxval=0.95, step=0.01)
keyLen   = input.int(16, "Key line length (bars)", minval=3)
txtOff   = input.int(4, "Text offset (bars)", minval=0)

// ===== Liquidity (swing high / low) =====
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh    = na
var int   lastHighBar = na
var bool  highSwept   = true
var float lastLow     = na
var int   lastLowBar  = na
var bool  lowSwept    = true

if not na(ph)
    lastHigh    := ph
    lastHighBar := bar_index - swingLen
    highSwept   := false
if not na(pl)
    lastLow     := pl
    lastLowBar  := bar_index - swingLen
    lowSwept    := false

// ===== Signal: sweep the liquidity, candle closes back inside =====
sellSig = barstate.isconfirmed and not highSwept and not na(lastHigh) and high > lastHigh and close < lastHigh
buySig  = barstate.isconfirmed and not lowSwept  and not na(lastLow)  and low  < lastLow  and close > lastLow

// ===== Drawing helpers (text centred on the price level, like TradingView) =====
txt(float price, string t, color col) =>
    label.new(bar_index + txtOff, price, t, style=label.style_none, textcolor=col, size=size.normal)
    true

keyLine(int fromBar, float price, string t) =>
    line.new(fromBar, price, bar_index + keyLen, price, color=chart.fg_color, width=2)
    label.new(bar_index + keyLen, price, t, style=label.style_label_down, color=color.new(color.white, 100), textcolor=chart.fg_color, size=size.normal)
    label.new(bar_index, price, "☀", style=label.style_none, textcolor=color.orange, size=size.large)
    true

if sellSig
    highSwept := true
    et1  = close
    sl   = high + slBuf
    risk = sl - et1
    et2  = sl - risk * et2Pct
    txt(et1 - risk * rr2, "TP 2: " + str.tostring(et1 - risk * rr2, format.mintick), color.blue)
    txt(et1 - risk * rr1, "TP 1: " + str.tostring(et1 - risk * rr1, format.mintick), color.blue)
    txt(et1, "Et 1: " + str.tostring(et1, format.mintick), color.gray)
    txt(et2, "Et 2: " + str.tostring(et2, format.mintick), color.gray)
    txt(sl,  "SL: "  + str.tostring(sl,  format.mintick), color.red)
    keyLine(lastHighBar, lastHigh, "BSL $$$ 💵")

if buySig
    lowSwept := true
    et1  = close
    sl   = low - slBuf
    risk = et1 - sl
    et2  = sl + risk * et2Pct
    txt(et1 + risk * rr2, "TP 2: " + str.tostring(et1 + risk * rr2, format.mintick), color.blue)
    txt(et1 + risk * rr1, "TP 1: " + str.tostring(et1 + risk * rr1, format.mintick), color.blue)
    txt(et1, "Et 1: " + str.tostring(et1, format.mintick), color.gray)
    txt(et2, "Et 2: " + str.tostring(et2, format.mintick), color.gray)
    txt(sl,  "SL: "  + str.tostring(sl,  format.mintick), color.red)
    keyLine(lastLowBar, lastLow, "Key 🔑")

alertcondition(sellSig, "Gold Fx SELL", "SELL {{ticker}} {{interval}} @ {{close}}")
alertcondition(buySig,  "Gold Fx BUY",  "BUY {{ticker}} {{interval}} @ {{close}}")
